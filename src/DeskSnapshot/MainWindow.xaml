<Window
    x:Class="DeskSnapshot.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <Grid Padding="16,0">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Image Source="Assets/DeskSnapshot_96x96.png" Width="26" Height="26" Stretch="Uniform" />
                    <TextBlock Text="DeskSnapshot" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="桌面布局备份" Foreground="{ThemeResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <NavigationView x:Name="AppNavigationView"
                        Grid.Row="1"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        IsPaneToggleButtonVisible="True"
                        IsPaneOpen="True"
                        PaneDisplayMode="Auto"
                        OpenPaneLength="232"
                        CompactPaneLength="48"
                        PaneOpened="AppNavigationView_PaneOpened"
                        PaneClosed="AppNavigationView_PaneClosed"
                        SelectionChanged="AppNavigationView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="DashboardNavItem" Content="概览" Tag="dashboard">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="BackupsNavItem" Content="备份记录" Tag="backups">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8C8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="SettingsNavItem" Content="设置" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <Border x:Name="LocalStorageFooter" Margin="8,8,8,14" Padding="12" CornerRadius="10" Background="{ThemeResource SubtleBrush}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="本地离线存储" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Text="布局数据不会上传" FontSize="11" Foreground="{ThemeResource MutedTextBrush}" />
                    </StackPanel>
                </Border>
            </NavigationView.PaneFooter>
            <NavigationView.Content>
            <Grid>
                <InfoBar x:Name="ActionInfoBar" Margin="28,16,28,0" VerticalAlignment="Top" IsOpen="False" IsClosable="True" Canvas.ZIndex="10" />

                <ScrollViewer x:Name="DashboardSection"
                              Padding="32,28,32,36"
                              HorizontalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Stretch" Spacing="24">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="5">
                                <TextBlock Text="桌面概览" Style="{ThemeResource TitleTextBlockStyle}" />
                                <TextBlock Text="保存此刻的图标位置，需要时一键还原。" Foreground="{ThemeResource MutedTextBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1" Click="CreateBackup_Click" Padding="18,10" CornerRadius="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74E;" FontSize="15" />
                                    <TextBlock Text="立即备份" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border CornerRadius="18" Padding="28" BorderThickness="0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1366D8" Offset="0" />
                                    <GradientStop Color="#6046C6" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="当前桌面已就绪" Foreground="White" FontSize="22" FontWeight="SemiBold" />
                                    <TextBlock x:Name="HeroEnvironmentText" Text="正在读取显示环境…" Foreground="#DFFFFFFF" />
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                        <Border Background="#25FFFFFF" CornerRadius="12" Padding="10,4">
                                            <TextBlock x:Name="HeroIconCountText" Text="等待首次备份" Foreground="White" FontSize="12" />
                                        </Border>
                                        <Border Background="#25FFFFFF" CornerRadius="12" Padding="10,4">
                                            <TextBlock x:Name="HeroDpiText" Text="DPI --" Foreground="White" FontSize="12" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                <FontIcon Grid.Column="1" Glyph="&#xE7F4;" Foreground="#55FFFFFF" FontSize="82" Margin="40,0,8,0" />
                            </Grid>
                        </Border>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="7">
                                    <FontIcon Glyph="&#xE8C8;" Foreground="#1667D9" HorizontalAlignment="Left" />
                                    <TextBlock x:Name="BackupCountText" Text="0" FontSize="26" FontWeight="SemiBold" />
                                    <TextBlock Text="历史备份" Foreground="{ThemeResource MutedTextBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="7">
                                    <FontIcon Glyph="&#xE81C;" Foreground="#0F9D75" HorizontalAlignment="Left" />
                                    <TextBlock x:Name="MonitorCountText" Text="--" FontSize="26" FontWeight="SemiBold" />
                                    <TextBlock Text="当前显示器" Foreground="{ThemeResource MutedTextBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="7">
                                    <FontIcon Glyph="&#xE823;" Foreground="#E58A16" HorizontalAlignment="Left" />
                                    <TextBlock x:Name="LastBackupText" Text="尚未备份" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,2" />
                                    <TextBlock Text="最近保存" Foreground="{ThemeResource MutedTextBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="恢复保护已开启" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="每次恢复前，DeskSnapshot 都会自动保存当前布局。" Foreground="{ThemeResource MutedTextBrush}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="查看所有备份" Click="BackupsNav_Click" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="BackupsSection" Visibility="Collapsed" Padding="32,28,32,30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="5">
                            <TextBlock Text="备份记录" Style="{ThemeResource TitleTextBlockStyle}" />
                            <TextBlock Text="选择一个布局进行恢复，缺失的图标会被安全跳过。" Foreground="{ThemeResource MutedTextBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Click="CreateBackup_Click" Padding="16,9">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74E;" FontSize="14" />
                                <TextBlock Text="新建备份" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
                        <Grid>
                            <TextBlock x:Name="EmptyBackupsText" Text="还没有备份，点击“新建备份”保存当前桌面。" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource MutedTextBrush}" />
                            <ListView x:Name="BackupsList"
                                      ItemsSource="{x:Bind BackupItems}"
                                      SelectionChanged="BackupsList_SelectionChanged"
                                      DoubleTapped="BackupsList_DoubleTapped"
                                      Margin="8"
                                      HorizontalContentAlignment="Stretch">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="12" />
                                        <Setter Property="Margin" Value="0,2" />
                                        <Setter Property="CornerRadius" Value="8" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Image Width="38" Height="38" Source="Assets/DeskSnapshot_96x96.png" Stretch="Uniform" />
                                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Details}" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CreatedAtDisplay}" FontSize="12" />
                                                <TextBlock Text="{Binding Badge}" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="4">
                        <TextBlock x:Name="SelectionHintText" Text="选择一条记录以执行操作" Foreground="{ThemeResource MutedTextBrush}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                            <Button x:Name="DeleteBackupButton" Content="删除" IsEnabled="False" Click="DeleteBackup_Click" />
                            <Button x:Name="ViewBackupButton" Content="查看详情" IsEnabled="False" Click="ViewBackup_Click" />
                            <Button x:Name="RestoreBackupButton" IsEnabled="False" Click="RestoreBackup_Click">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="&#xE777;" FontSize="14" />
                                    <TextBlock Text="恢复所选布局" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>

                <ScrollViewer x:Name="SettingsSection"
                              Visibility="Collapsed"
                              Padding="32,28,32,36"
                              HorizontalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Stretch" Spacing="20">
                        <StackPanel Spacing="5">
                            <TextBlock Text="设置" Style="{ThemeResource TitleTextBlockStyle}" />
                            <TextBlock Text="调整 DeskSnapshot 的外观和行为。" Foreground="{ThemeResource MutedTextBrush}" />
                        </StackPanel>

                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="自动备份" FontWeight="SemiBold" FontSize="16" />
                                    <TextBlock x:Name="AutoBackupStatusText"
                                               Text="自动备份已关闭"
                                               Foreground="{ThemeResource MutedTextBrush}"
                                               FontSize="12" />
                                </StackPanel>
                                <ToggleSwitch x:Name="AutoBackupToggle"
                                              Grid.Column="1"
                                              OffContent="关"
                                              OnContent="开"
                                              Toggled="AutoBackupSettings_Changed" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="定时备份" FontWeight="SemiBold" />
                                        <TextBlock Text="按固定间隔保存当前桌面布局。" Foreground="{ThemeResource MutedTextBrush}" FontSize="12" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="ScheduledBackupToggle"
                                                  Grid.Column="1"
                                                  Toggled="AutoBackupSettings_Changed" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="180" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="备份间隔" VerticalAlignment="Center" />
                                    <ComboBox x:Name="BackupIntervalComboBox"
                                              Grid.Column="1"
                                              SelectedIndex="2"
                                              SelectionChanged="BackupIntervalComboBox_SelectionChanged">
                                        <ComboBoxItem Content="每 5 分钟" Tag="5" />
                                        <ComboBoxItem Content="每 15 分钟" Tag="15" />
                                        <ComboBoxItem Content="每 30 分钟" Tag="30" />
                                        <ComboBoxItem Content="每 1 小时" Tag="60" />
                                        <ComboBoxItem Content="每 3 小时" Tag="180" />
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="事件触发" FontWeight="SemiBold" />
                                    <TextBlock Text="事件检测采用防抖处理，避免短时间内重复生成备份。" Foreground="{ThemeResource MutedTextBrush}" FontSize="12" />
                                </StackPanel>
                                <CheckBox x:Name="StartupTriggerCheckBox"
                                          Content="程序启动后备份"
                                          Click="AutoBackupSettings_Changed" />
                                <CheckBox x:Name="DisplayTriggerCheckBox"
                                          Content="显示器、分辨率或 DPI 变化后备份"
                                          Click="AutoBackupSettings_Changed" />
                                <CheckBox x:Name="DesktopTriggerCheckBox"
                                          Content="桌面图标增加、删除或位置变化后备份"
                                          Click="AutoBackupSettings_Changed" />
                                <TextBlock Text="自动备份最多保留最近 20 份。" Foreground="{ThemeResource MutedTextBrush}" FontSize="12" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="应用主题" FontWeight="SemiBold" />
                                    <TextBlock Text="选择浅色、深色或跟随 Windows。" Foreground="{ThemeResource MutedTextBrush}" FontSize="12" />
                                </StackPanel>
                                <ComboBox x:Name="ThemeComboBox" Grid.Column="1" SelectedIndex="0" SelectionChanged="ThemeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="跟随系统" Tag="Default" />
                                    <ComboBoxItem Content="浅色" Tag="Light" />
                                    <ComboBoxItem Content="深色" Tag="Dark" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="数据位置" FontWeight="SemiBold" />
                                <TextBlock x:Name="StoragePathText" TextWrapping="Wrap" Foreground="{ThemeResource MutedTextBrush}" FontFamily="Consolas" FontSize="12" />
                                <TextBlock Text="Demo 采用原子写入方式保存 JSON；损坏的数据文件会被自动隔离。" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="恢复前安全备份" FontWeight="SemiBold" />
                                    <TextBlock Text="第一版中始终开启，避免误恢复后无法回退。" Foreground="{ThemeResource MutedTextBrush}" FontSize="12" />
                                </StackPanel>
                                <ToggleSwitch IsOn="True" IsEnabled="False" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="BusyOverlay" Background="#66000000" Visibility="Collapsed" Canvas.ZIndex="20">
                    <Border Background="{ThemeResource CardBrush}" CornerRadius="14" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <ProgressRing IsActive="True" Width="24" Height="24" />
                            <TextBlock x:Name="BusyText" Text="正在处理桌面布局…" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
            </NavigationView.Content>
        </NavigationView>
    </Grid>
</Window>
